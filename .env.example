# Copy this file to .env and fill in values before running docker compose.
# Never commit .env with real secrets.

# PostgreSQL
POSTGRES_DB=timetracker
POSTGRES_USER=timetracker
POSTGRES_PASSWORD=change_me_in_production

# JWT — must be a Base64-encoded string of at least 256 bits (32 bytes).
# The value below is a valid example; generate your own for production, e.g.:
#   openssl rand -base64 32
JWT_SECRET=+A4ADiDXAL0bdLbPfeR6KwkSW9p9CYgkmrhAo2s7QVk=
