# Copy this file to .env and fill in values before running docker compose.
# Never commit .env with real secrets.

# PostgreSQL
POSTGRES_DB=timetracker
POSTGRES_USER=timetracker
POSTGRES_PASSWORD=change_me_in_production

# JWT — must be a Base64-encoded string of at least 256 bits (32 bytes)
JWT_SECRET=change_me_to_a_random_base64_string_of_at_least_32_chars_long
